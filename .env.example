# Copy to ~/.local/share/jobdeck/.env or secrets.env, or export the values.
# See docs/engineering/local-operations.md for precedence and data handling.

# Optional complete data-directory override (useful for isolated development).
# JOBDECK_DATA_DIR=/absolute/path/to/jobdeck-data

# Jooble job search API key — free, request at https://jooble.org/api/about
JOOBLE_API_KEY=

# Anthropic API key for enabled scoring, claim proposals, drafting, contact
# lookup, and reply classification — https://console.anthropic.com
ANTHROPIC_API_KEY=

# High-volume model used for scoring, contact extraction, and reply
# classification (optional; current default).
ANTHROPIC_MODEL=claude-haiku-4-5

# Drafting model used for Anschreiben and e-mail generation
# (optional; current default).
ANTHROPIC_DRAFTING_MODEL=claude-sonnet-5
